            "required": true,
            "type": "string"
        }
    },
    "setShowWarnings": {
        "boolean": {
            "required": true,
            "type": "boolean",
            "default": ""
        }
    },
    "learnMood": {
        "moodName": {
            "required": true,
            "type": "string"
        },
